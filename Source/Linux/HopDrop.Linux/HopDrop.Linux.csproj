<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>HopDrop.Linux</AssemblyName>
    <Version>1.3.0-linux-preview.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="../../Windows/HopDrop.Core/HopDrop.Core.csproj" />
    <ProjectReference Include="../../Shared/HopDrop.Agents/HopDrop.Agents.csproj" />
    <AvaloniaResource Include="Assets/HopDrop.ico" />
    <AvaloniaResource Include="Assets/HopDrop.png" />
  </ItemGroup>
</Project>
